# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files — NEVER commit these.
# The trailing * matters: it also covers local backups such as
# .env.local.rescue-backup, .env.local.bak and .env.production.local.old,
# which the bare filenames alone did not match.
.env
.env.*
.env.local*
.env.development.local*
.env.test.local*
.env.production.local*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Supabase
/supabase/.branches
/supabase/.temp

# Rust / Tauri build artifacts (if desktop app added later)
/desktop/src-tauri/target

# Logs
*.log
scripts/loadtest-results.json
